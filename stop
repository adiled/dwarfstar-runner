#!/bin/sh
# Stop everything: every model grove, then the front door.
set -eu

ROOT=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)

ORCHD=${ORCHD:-$HOME/.local/bin/orchd}
[ -x "$ORCHD" ] || ORCHD=orchd
state_root=${STATE_ROOT:-$HOME/.orch/g}

for f in "$ROOT"/services/*.orch; do
    n=$(basename "$f" .orch)
    "$ORCHD" --project-dir "$ROOT" --state-dir "$state_root/$n" \
             --namespace "$n" --user fell --keep-data >/dev/null 2>&1 || true
done

"$ORCHD" --project-dir "$ROOT" --state-dir "$state_root/ctl" \
         --orchfile "$ROOT/arbiter.orch" --namespace ctl --user fell --keep-data \
         >/dev/null 2>&1 || true
