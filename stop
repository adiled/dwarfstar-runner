#!/bin/sh
# Stop everything: the model grove, then the front door.
set -eu

ROOT=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)

ORCHD=${ORCHD:-$HOME/.local/bin/orchd}
[ -x "$ORCHD" ] || ORCHD=orchd
state_root=${STATE_ROOT:-$HOME/.orch/g}

# The models share one grove, made of every Orchfile in servers/: the first is
# the base and the rest are overlays.
set --
for f in "$ROOT"/servers/*.orch; do
    [ -e "$f" ] || continue
    if [ $# -eq 0 ]; then set -- --orchfile "$f"; else set -- "$@" --overlay "$f"; fi
done

# Fell it with its Orchfiles, or without them when they no longer resolve.
"$ORCHD" --project-dir "$ROOT" --state-dir "$state_root/dwarfstar" "$@" \
         --grove dwarfstar --user fell --keep-data >/dev/null 2>&1 ||
"$ORCHD" --project-dir "$ROOT" --state-dir "$state_root/dwarfstar" \
         --grove dwarfstar --user fell --keep-data >/dev/null 2>&1 || true

"$ORCHD" --project-dir "$ROOT" --state-dir "$state_root/ctl" \
         --orchfile "$ROOT/arbiter.orch" --grove ctl --user fell --keep-data \
         >/dev/null 2>&1 || true
