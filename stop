#!/bin/sh
# Stop everything: the front door, the watch, and whichever model is up.
set -eu

ROOT=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)

ORCHD=${ORCHD:-$HOME/.local/bin/orchd}
[ -x "$ORCHD" ] || ORCHD=orchd
STATE_DIR=${STATE_DIR:-$HOME/.orch/g/dwarfstar}

"$ORCHD" --project-dir "$ROOT" --state-dir "$STATE_DIR" fell --keep-data \
         >/dev/null 2>&1 || true
