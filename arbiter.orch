ORCH_VERSION 1.0.0-rc

# The ds4 checkout every server template runs from. The arbiter runs under
# launchd, away from your shell, so it hands this on to each model grove it
# grows through ORCH_ARG_DWARFSTAR_DIR. Set it with
# `ORCH_ARG_DWARFSTAR_DIR=/path ./run`.
ARG DWARFSTAR_DIR=~/ds4

SERVICE arbiter
RUN bash -c 'exec "${ORCH_PROJECT}/arbiter" --dir "${ORCH_PROJECT}" --orch ~/.local/bin/orch --orchd ~/.local/bin/orchd --listen 127.0.0.1:8899'
ENV ORCH_ARG_DWARFSTAR_DIR=${DWARFSTAR_DIR}
STDOUT /tmp/ds4-arbiter.log
STDERR /tmp/ds4-arbiter.log
HEALTHCHECK http://127.0.0.1:8899/v1/models
RESTART always
