#!/bin/sh
# Grow the ds4 front door. This is the whole install:
#
#   ./run            build if needed, then start the front door. That's it.
#   ./run restart    restart the front door (after changing specs or code)
#   ./run down       stop the front door
#   ./run stop       unload every model, freeing the GPU
#   ./run status     list each model and whether it is running
#   ./run build      just build the front door
#   ./run <model> <verb> [...]   poke one model directly, e.g.
#                                ./run glm53server grow   (start it)
#                                ./run ds4server fell     (stop it)
#
# After `./run`, point any OpenAI client at http://127.0.0.1:8899/v1 and ask
# for a model by name; the front door raises it. No per-model commands needed
# in normal use.
set -eu

ROOT=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)

ORCHD=${ORCHD:-$HOME/.local/bin/orchd}
[ -x "$ORCHD" ] || ORCHD=orchd
state_root=${STATE_ROOT:-$HOME/.orch/g}

build() {
    [ -x "$ROOT/arbiter" ] || make -C "$ROOT"
}

ctl() {
    "$ORCHD" --project-dir "$ROOT" --state-dir "$state_root/ctl" \
             --orchfile "$ROOT/arbiter.orch" --namespace ctl --user "$@"
}

mdl() {
    name=$1; shift
    "$ORCHD" --project-dir "$ROOT" --state-dir "$state_root/$name" \
             --orchfile "$ROOT/services/$name.orch" --namespace "$name" --user "$@"
}

case "${1:-up}" in
    up)      build; ctl grow ;;
    restart) build; ctl fell --keep-data || true; ctl grow ;;
    down)    ctl fell --keep-data ;;
    build)   build ;;
    stop)    for f in "$ROOT"/services/*.orch; do
                 mdl "$(basename "$f" .orch)" fell --keep-data || true
             done ;;
    status)  for f in "$ROOT"/services/*.orch; do
                 n=$(basename "$f" .orch)
                 printf '%-22s ' "$n"
                 mdl "$n" survey --json 2>/dev/null | tr -d '\n' || true
                 echo
             done ;;
    *)       name=$1; shift; mdl "$name" "$@" ;;
esac
