#!/bin/sh
# Start the ds4 front door (building it first if needed).
#
# Then point a client at http://127.0.0.1:8899/v1 and name a model. The front
# door owns the GPU and swaps the holder under a single lock. To stop
# everything, run ./stop. Power users can drive `orchd` directly.
set -eu

ROOT=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)

ORCHD=${ORCHD:-$HOME/.local/bin/orchd}
[ -x "$ORCHD" ] || ORCHD=orchd
state_root=${STATE_ROOT:-$HOME/.orch/g}

[ -x "$ROOT/arbiter" ] || make -C "$ROOT"

"$ORCHD" --project-dir "$ROOT" --state-dir "$state_root/ctl" \
         --orchfile "$ROOT/arbiter.orch" --namespace ctl --user grow
