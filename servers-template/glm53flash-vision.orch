ORCH_VERSION 1.0.0-rc

# The ds4 checkout: ds4-server, and its GGUFs under gguf/. Override per machine
# with ORCH_ARG_DWARFSTAR_DIR (see README).
ARG DWARFSTAR_DIR=~/ds4

SERVICE glm53flash-vision
RUN bash -c 'mkdir -p ~/.ds4/dwarfstar-runner/logs && cd ${DWARFSTAR_DIR} && exec nice -n 10 ${DWARFSTAR_DIR}/ds4-server --model ${DWARFSTAR_DIR}/gguf/GLM-5.3-Flash-Q2.gguf --host 0.0.0.0 --port 8903 --cors --backend metal --ctx 32768 --mtp --vision ${DWARFSTAR_DIR}/gguf/GLM-5.3-Flash-Vision-Encoder.gguf --kv-disk-dir ~/.ds4/dwarfstar-runner/kv/glm53server --kv-disk-space-mb 16384 --threads 8 >> ~/.ds4/dwarfstar-runner/logs/glm53flash-vision.log 2>&1'
ENV DS4_LOCK_FILE=/tmp/ds4-gpu.lock
ENV MODELS=glm-5.3-flash-vision
HEALTHCHECK http://127.0.0.1:8903/v1/models
RESTART no
