ORCH_VERSION 1.0.0-rc

# The ds4 checkout: ds4-server, and its GGUFs under gguf/. Override per machine
# with ORCH_ARG_DWARFSTAR_DIR (see README).
ARG DWARFSTAR_DIR=~/ds4

SERVICE ds4flash-q2-legacy
RUN bash -c 'cd ${DWARFSTAR_DIR} && exec nice -n 10 ${DWARFSTAR_DIR}/ds4-server --model ${DWARFSTAR_DIR}/gguf/DeepSeek-V4-Flash-IQ2XXS-w2Q2K-AProjQ8-SExpQ8-OutQ8-chat-v2-imatrix.gguf --host 0.0.0.0 --port 8891 --cors --ctx 32768 --kv-disk-dir ~/.ds4/server-kv-ds4flash-q2-legacy --kv-disk-space-mb 8192 --threads 8'
ENV DS4_LOCK_FILE=/tmp/ds4-gpu.lock
ENV MODELS=deepseek-v4-flash-iq2-legacy
STDOUT /tmp/ds4-flash-q2-legacy.log
STDERR /tmp/ds4-flash-q2-legacy.log
HEALTHCHECK http://127.0.0.1:8891/v1/models
RESTART no
