ORCH_VERSION 1.0.0-rc

# The ds4 checkout: ds4-server, and its GGUFs under gguf/. Override per machine
# with ORCH_ARG_DWARFSTAR_DIR (see README).
ARG DWARFSTAR_DIR=~/ds4

SERVICE ds4flash-q4
RUN bash -c 'cd ${DWARFSTAR_DIR} && exec nice -n 10 ${DWARFSTAR_DIR}/ds4-server --model ${DWARFSTAR_DIR}/gguf/DeepSeek-V4-Flash-Q4KExperts-F16HC-F16Compressor-F16Indexer-Q8Attn-Q8Shared-Q8Out-chat-v2-imatrix-0731.gguf --host 0.0.0.0 --port 8892 --cors --ctx 32768 --ssd-streaming --kv-disk-dir ~/.ds4/server-kv-ds4flash-q4 --kv-disk-space-mb 8192 --threads 8'
ENV DS4_LOCK_FILE=/tmp/ds4-gpu.lock
ENV MODELS=deepseek-v4-flash-q4
STDOUT /tmp/ds4-ds4flash-q4.log
STDERR /tmp/ds4-ds4flash-q4.log
HEALTHCHECK http://127.0.0.1:8892/v1/models
RESTART no
