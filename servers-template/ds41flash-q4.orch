ORCH_VERSION 1.0.0-rc

# The ds4 checkout: ds4-server, and its GGUFs under gguf/. Override per machine
# with ORCH_ARG_DWARFSTAR_DIR (see README).
ARG DWARFSTAR_DIR=~/ds4

SERVICE ds41flash-q4
RUN bash -c 'cd ${DWARFSTAR_DIR} && exec nice -n 10 ${DWARFSTAR_DIR}/ds4-server --model ${DWARFSTAR_DIR}/gguf/DeepSeek-V4.1-Flash-Q4.gguf --host 0.0.0.0 --port 8897 --cors --ctx 32768 --ssd-streaming --kv-disk-dir ~/.ds4/server-kv-ds41flash-q4 --kv-disk-space-mb 8192 --threads 8'
ENV DS4_LOCK_FILE=/tmp/ds4-gpu.lock
ENV MODELS=deepseek-v4.1-flash-q4
STDOUT /tmp/ds4-ds41flash-q4.log
STDERR /tmp/ds4-ds41flash-q4.log
HEALTHCHECK http://127.0.0.1:8897/v1/models
RESTART no
