ORCH_VERSION 1.0.0-rc

# The ds4 checkout: ds4-server, and its GGUFs under gguf/. Override per machine
# with ORCH_ARG_DWARFSTAR_DIR (see README).
ARG DWARFSTAR_DIR=~/ds4

SERVICE glm52-unsloth-q4
RUN bash -c 'mkdir -p ~/.ds4/dwarfstar-runner/logs && cd ${DWARFSTAR_DIR} && exec nice -n 10 ${DWARFSTAR_DIR}/ds4-server --model ${DWARFSTAR_DIR}/gguf/GLM-5.2-UD-Q4_K_XL-00001-of-00011.gguf --host 0.0.0.0 --port 8908 --cors --backend metal --ctx 32768 --ssd-streaming --kv-disk-dir ~/.ds4/dwarfstar-runner/kv/glm52-unsloth-q4 --kv-disk-space-mb 8192 --threads 8 >> ~/.ds4/dwarfstar-runner/logs/glm52-unsloth-q4.log 2>&1'
ENV DS4_LOCK_FILE=/tmp/ds4-gpu.lock
ENV MODELS=glm-5.2-unsloth-q4
ENV WEIGHTS=${DWARFSTAR_DIR}/gguf/GLM-5.2-UD-Q4_K_XL-00001-of-00011.gguf,${DWARFSTAR_DIR}/gguf/GLM-5.2-UD-Q4_K_XL-00002-of-00011.gguf,${DWARFSTAR_DIR}/gguf/GLM-5.2-UD-Q4_K_XL-00003-of-00011.gguf,${DWARFSTAR_DIR}/gguf/GLM-5.2-UD-Q4_K_XL-00004-of-00011.gguf,${DWARFSTAR_DIR}/gguf/GLM-5.2-UD-Q4_K_XL-00005-of-00011.gguf,${DWARFSTAR_DIR}/gguf/GLM-5.2-UD-Q4_K_XL-00006-of-00011.gguf,${DWARFSTAR_DIR}/gguf/GLM-5.2-UD-Q4_K_XL-00007-of-00011.gguf,${DWARFSTAR_DIR}/gguf/GLM-5.2-UD-Q4_K_XL-00008-of-00011.gguf,${DWARFSTAR_DIR}/gguf/GLM-5.2-UD-Q4_K_XL-00009-of-00011.gguf,${DWARFSTAR_DIR}/gguf/GLM-5.2-UD-Q4_K_XL-00010-of-00011.gguf,${DWARFSTAR_DIR}/gguf/GLM-5.2-UD-Q4_K_XL-00011-of-00011.gguf
HEALTHCHECK http://127.0.0.1:8908/v1/models
RESTART no
