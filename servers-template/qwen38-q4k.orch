ORCH_VERSION 1.0.0-rc

# The ds4 checkout: ds4-server, and its GGUFs under gguf/. Override per machine
# with ORCH_ARG_DWARFSTAR_DIR (see README).
ARG DWARFSTAR_DIR=~/ds4

SERVICE qwen38-q4k
RUN bash -c 'cd ${DWARFSTAR_DIR} && exec nice -n 10 ${DWARFSTAR_DIR}/ds4-server --model ${DWARFSTAR_DIR}/gguf/Qwen3.8-Flash-Next-Q4.gguf --host 0.0.0.0 --port 8910 --cors --ctx 32768 --mtp --kv-disk-dir ~/.ds4/server-kv-qwen38-q4k --kv-disk-space-mb 8192 --threads 8'
ENV DS4_LOCK_FILE=/tmp/ds4-gpu.lock
ENV MODELS=qwen3.8-flash-next,qwen3.8-flash-next-q4
STDOUT /tmp/ds4-qwen38-q4k.log
STDERR /tmp/ds4-qwen38-q4k.log
HEALTHCHECK http://127.0.0.1:8910/v1/models
RESTART no
