ORCH_VERSION 1.0.0-rc

# The ds4 checkout: ds4-server, and its GGUFs under gguf/. Override per machine
# with ORCH_ARG_DWARFSTAR_DIR (see README).
ARG DWARFSTAR_DIR=~/ds4

SERVICE ds4vision-mxfp4
RUN bash -c 'mkdir -p ~/.ds4/dwarfstar-runner/logs && cd ${DWARFSTAR_DIR} && exec nice -n 10 ${DWARFSTAR_DIR}/ds4-server --model ${DWARFSTAR_DIR}/gguf/DeepSeek-V4-Flash-Vision-Exp-MXFP4Experts-F16HC-F16Compressor-F16Indexer-Q8Attn-Q8Shared-Q8Out.gguf --host 0.0.0.0 --port 8896 --cors --ctx 32768 --ssd-streaming --vision ${DWARFSTAR_DIR}/gguf/DeepSeek-V4-Flash-Vision-Encoder.gguf --kv-disk-dir ~/.ds4/dwarfstar-runner/kv/ds4vision-mxfp4 --kv-disk-space-mb 8192 --threads 8 >> ~/.ds4/dwarfstar-runner/logs/ds4vision-mxfp4.log 2>&1'
ENV DS4_LOCK_FILE=/tmp/ds4-gpu.lock
ENV MODELS=deepseek-v4-flash-vision-mxfp4
ENV WEIGHTS=${DWARFSTAR_DIR}/gguf/DeepSeek-V4-Flash-Vision-Exp-MXFP4Experts-F16HC-F16Compressor-F16Indexer-Q8Attn-Q8Shared-Q8Out.gguf,${DWARFSTAR_DIR}/gguf/DeepSeek-V4-Flash-Vision-Encoder.gguf
HEALTHCHECK http://127.0.0.1:8896/v1/models
RESTART no
