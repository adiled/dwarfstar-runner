ORCH_VERSION 1.0.0-rc

# The ds4 checkout: ds4-server, and its GGUFs under gguf/. Override per machine
# with ORCH_ARG_DWARFSTAR_DIR (see README).
ARG DWARFSTAR_DIR=~/ds4

SERVICE ds41flash-mxfp4
RUN bash -c 'mkdir -p ~/.ds4/dwarfstar-runner/logs && cd ${DWARFSTAR_DIR} && exec nice -n 10 ${DWARFSTAR_DIR}/ds4-server --model ${DWARFSTAR_DIR}/gguf/DeepSeek-V4.1-Flash-1017-MXFP4-experts.gguf --host 0.0.0.0 --port 8898 --cors --ctx 32768 --ssd-streaming --kv-disk-dir ~/.ds4/dwarfstar-runner/kv/ds41flash-mxfp4 --kv-disk-space-mb 8192 --threads 8 >> ~/.ds4/dwarfstar-runner/logs/ds41flash-mxfp4.log 2>&1'
ENV DS4_LOCK_FILE=/tmp/ds4-gpu.lock
ENV MODELS=deepseek-v4.1-flash-mxfp4
HEALTHCHECK http://127.0.0.1:8898/v1/models
RESTART no
