ORCH_VERSION 1.0.0-rc

# The ds4 checkout: ds4-server, and its GGUFs under gguf/. Override per machine
# with ORCH_ARG_DWARFSTAR_DIR (see README).
ARG DWARFSTAR_DIR=~/ds4

SERVICE ds41flash-vision
RUN bash -c 'cd ${DWARFSTAR_DIR} && exec nice -n 10 ${DWARFSTAR_DIR}/ds4-server --model ${DWARFSTAR_DIR}/gguf/DeepSeek-V4.1-Flash-1017-IQ2_XXS-Q2_K-imatrix.gguf --host 0.0.0.0 --port 8900 --cors --ctx 65536 --ssd-streaming --vision ${DWARFSTAR_DIR}/gguf/DeepSeek-V4.1-Flash-Vision.gguf --kv-disk-dir ~/.ds4/server-kv-v41 --kv-disk-space-mb 16384 --threads 8'
ENV DS4_LOCK_FILE=/tmp/ds4-gpu.lock
ENV MODELS=deepseek-v4.1-flash-vision
STDOUT /tmp/ds4-ds41flash-vision.log
STDERR /tmp/ds4-ds41flash-vision.log
HEALTHCHECK http://127.0.0.1:8900/v1/models
RESTART no
