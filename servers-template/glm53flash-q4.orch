ORCH_VERSION 1.0.0-rc

# The ds4 checkout: ds4-server, and its GGUFs under gguf/. Override per machine
# with ORCH_ARG_DWARFSTAR_DIR (see README).
ARG DWARFSTAR_DIR=~/ds4

SERVICE glm53flash-q4
RUN bash -c 'cd ${DWARFSTAR_DIR} && exec nice -n 10 ${DWARFSTAR_DIR}/ds4-server --model ${DWARFSTAR_DIR}/gguf/GLM-5.3-Flash-Q4_K.gguf --host 0.0.0.0 --port 8902 --cors --backend metal --ctx 32768 --ssd-streaming --kv-disk-dir ~/.ds4/server-kv-glm53flash-q4 --kv-disk-space-mb 8192 --threads 8'
ENV DS4_LOCK_FILE=/tmp/ds4-gpu.lock
ENV MODELS=glm-5.3-flash-q4
STDOUT /tmp/ds4-glm53flash-q4.log
STDERR /tmp/ds4-glm53flash-q4.log
HEALTHCHECK http://127.0.0.1:8902/v1/models
RESTART no
