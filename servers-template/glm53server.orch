ORCH_VERSION 1.0.0-rc

# The ds4 checkout: ds4-server, and its GGUFs under gguf/. Override per machine
# with ORCH_ARG_DWARFSTAR_DIR (see README).
ARG DWARFSTAR_DIR=~/ds4

SERVICE glm53server
RUN bash -c 'cd ${DWARFSTAR_DIR} && exec nice -n 10 ${DWARFSTAR_DIR}/ds4-server --model ${DWARFSTAR_DIR}/gguf/GLM-5.3-Flash-Q2.gguf --host 0.0.0.0 --port 8889 --cors --backend metal --ctx 32768 --mtp --kv-disk-dir ~/.ds4/server-kv-glm --kv-disk-space-mb 16384 --threads 8'
ENV DS4_LOCK_FILE=/tmp/ds4-gpu.lock
ENV MODELS=glm-5.2,glm-5.2-chat,glm-5.2-reasoner
STDOUT /tmp/ds4-glm53.log
STDERR /tmp/ds4-glm53.log
HEALTHCHECK http://127.0.0.1:8889/v1/models
RESTART no
