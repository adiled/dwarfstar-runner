ORCH_VERSION 1.0.0-rc

# Every DwarfStar model the front door can serve, one SERVICE each. They are
# planted into one grove, and the arbiter grows and fells them by name, so at
# most one runs at a time. See the README for the conventions a service
# follows.
#
# Each is DISABLED, so orchd starts it only when the arbiter names it and
# never at login.

# The ds4 checkout: ds4-server, and its GGUFs under gguf/. Override per machine
# with ORCH_ARG_DWARFSTAR_DIR (see README).
ARG DWARFSTAR_DIR=~/ds4

SERVICE ds4server
RUN bash -c 'mkdir -p ~/.ds4/dwarfstar-runner/logs && cd ${DWARFSTAR_DIR} && exec nice -n 10 ${DWARFSTAR_DIR}/ds4-server --model ${DWARFSTAR_DIR}/gguf/DeepSeek-V4-Flash-Layers37-42Q4KExperts-OtherExpertLayersIQ2XXSGateUp-Q2KDown-AProjQ8-SExpQ8-OutQ8-chat-v2-imatrix-fixed-0731.gguf --host 0.0.0.0 --port 8888 --cors --ctx 100000 --dspark --mtp-model ${DWARFSTAR_DIR}/gguf/DeepSeek-V4-Flash-DSpark-support-0731.gguf --kv-disk-dir ~/.ds4/dwarfstar-runner/kv/ds4server --kv-disk-space-mb 16384 --threads 8 >> ~/.ds4/dwarfstar-runner/logs/ds4server.log 2>&1'
ENV DS4_LOCK_FILE=/tmp/ds4-gpu.lock
ENV MODELS=deepseek-v4-flash
ENV WEIGHTS=${DWARFSTAR_DIR}/gguf/DeepSeek-V4-Flash-Layers37-42Q4KExperts-OtherExpertLayersIQ2XXSGateUp-Q2KDown-AProjQ8-SExpQ8-OutQ8-chat-v2-imatrix-fixed-0731.gguf,${DWARFSTAR_DIR}/gguf/DeepSeek-V4-Flash-DSpark-support-0731.gguf
