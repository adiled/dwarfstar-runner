ORCH_VERSION 1.0.0-rc

# The whole runner: the front door (arbiter), the watch, and every DwarfStar
# model, one SERVICE each, in one grove. `orchd grow` starts the arbiter and
# the watch. A model is DISABLED, so orchd starts it only when the arbiter
# names it and never at login; the arbiter grows and fells models by name, so
# at most one runs at a time. A service is a model when it sets ENV MODELS.
# See the README for the conventions a model follows.

# Where this repository is checked out. orchd passes the real project
# directory; the default lets the file resolve on its own.
ARG ORCH_PROJECT=~/ds4-runner

# The ds4 checkout: ds4-server, and its GGUFs under gguf/. Override per machine
# with ORCH_ARG_DWARFSTAR_DIR (see README). The arbiter runs under launchd,
# away from your shell, so it hands the value on to the models it grows.
ARG DWARFSTAR_DIR=~/ds4

# Where every service logs.
ARG LOGS=~/.ds4/dwarfstar-runner/logs

# When the watch raises "Watch out! Dwarfstar is cooking ...": seconds between
# checks, swap growth since a model loaded, and free disk where models live.
ARG WATCH_INTERVAL=15
ARG WATCH_SWAP_GROWTH_GB=2
ARG WATCH_DISK_MIN_GB=25

SERVICE arbiter
RUN ${ORCH_PROJECT}/arbiter --dir ${ORCH_PROJECT} --orch ~/.local/bin/orch --orchd ~/.local/bin/orchd --listen 127.0.0.1:8899
ENV ORCH_ARG_DWARFSTAR_DIR=${DWARFSTAR_DIR}
HEALTHCHECK http://127.0.0.1:8899/v1/models
RESTART always
STDOUT ${LOGS}/arbiter.log
STDERR ${LOGS}/arbiter.log

SERVICE watch
RUN ${ORCH_PROJECT}/watch
ENV DWARFSTAR_DIR=${DWARFSTAR_DIR}
ENV WATCH_INTERVAL=${WATCH_INTERVAL}
ENV WATCH_SWAP_GROWTH_GB=${WATCH_SWAP_GROWTH_GB}
ENV WATCH_DISK_MIN_GB=${WATCH_DISK_MIN_GB}
RESTART always
STDOUT ${LOGS}/watch.log
STDERR ${LOGS}/watch.log

SERVICE ds4server
RUN nice -n 10 ${DWARFSTAR_DIR}/ds4-server --model ${DWARFSTAR_DIR}/gguf/DeepSeek-V4-Flash-Layers37-42Q4KExperts-OtherExpertLayersIQ2XXSGateUp-Q2KDown-AProjQ8-SExpQ8-OutQ8-chat-v2-imatrix-fixed-0731.gguf --host 0.0.0.0 --port 8888 --cors --ctx 100000 --dspark --mtp-model ${DWARFSTAR_DIR}/gguf/DeepSeek-V4-Flash-DSpark-support-0731.gguf --kv-disk-dir ~/.ds4/dwarfstar-runner/kv/ds4server --kv-disk-space-mb 16384 --threads 8
