RUN bash -c 'mkdir -p ~/.ds4/dwarfstar-runner/logs && cd ${DWARFSTAR_DIR} && exec nice -n 10 ${DWARFSTAR_DIR}/ds4-server --model ${DWARFSTAR_DIR}/gguf/Qwen3.8-Flash-Next-Q2.gguf --host 0.0.0.0 --port 8909 --cors --ctx 32768 --mtp --kv-disk-dir ~/.ds4/dwarfstar-runner/kv/qwen38-q2 --kv-disk-space-mb 8192 --threads 8 >> ~/.ds4/dwarfstar-runner/logs/qwen38-q2.log 2>&1'
ENV DS4_LOCK_FILE=/tmp/ds4-gpu.lock
ENV MODELS=qwen3.8-flash-next-q2
ENV WEIGHTS=${DWARFSTAR_DIR}/gguf/Qwen3.8-Flash-Next-Q2.gguf
HEALTHCHECK http://127.0.0.1:8909/v1/models
DISABLED true
RESTART no

SERVICE qwen38-q4k-vision
RUN bash -c 'mkdir -p ~/.ds4/dwarfstar-runner/logs && cd ${DWARFSTAR_DIR} && exec nice -n 10 ${DWARFSTAR_DIR}/ds4-server --model ${DWARFSTAR_DIR}/gguf/Qwen3.8-Flash-Next-Q4.gguf --host 0.0.0.0 --port 8911 --cors --ctx 32768 --mtp --vision ${DWARFSTAR_DIR}/gguf/mmproj-Qwen3.8-Flash-Next-Q8_0.gguf --kv-disk-dir ~/.ds4/dwarfstar-runner/kv/qwen38-q4k --kv-disk-space-mb 8192 --threads 8 >> ~/.ds4/dwarfstar-runner/logs/qwen38-q4k-vision.log 2>&1'
ENV DS4_LOCK_FILE=/tmp/ds4-gpu.lock
ENV MODELS=qwen3.8-flash-next-vision
ENV WEIGHTS=${DWARFSTAR_DIR}/gguf/Qwen3.8-Flash-Next-Q4.gguf,${DWARFSTAR_DIR}/gguf/mmproj-Qwen3.8-Flash-Next-Q8_0.gguf
HEALTHCHECK http://127.0.0.1:8911/v1/models
DISABLED true
RESTART no
